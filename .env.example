# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTH_USERNAME: Master admin username for legacy API endpoint authentication (optional).
AUTH_USERNAME=""

# AUTH_PASSWORD: Strong master password (required if AUTH_USERNAME is configured).
AUTH_PASSWORD=""

# GEMINI_MODEL_CANDIDATES: Optional comma-separated model fallback order.
# Defaults to: gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
# GEMINI_MODEL_CANDIDATES="gemini-3.8-flash,gemini-2.5-flash,gemini-2.0-flash"

# PENGATURAN DATABASE ISOLATION & CONFIGURATION
# Standard environment variables for database isolation on Menu Pengaturan.
# When remixing or cloning this project, configure your own database credentials here:
VITE_PENGATURAN_FIREBASE_API_KEY=""
VITE_PENGATURAN_FIREBASE_PROJECT_ID=""
VITE_PENGATURAN_FIREBASE_DATABASE_ID=""
VITE_PENGATURAN_FIREBASE_AUTH_DOMAIN=""
VITE_PENGATURAN_FIREBASE_STORAGE_BUCKET=""
VITE_PENGATURAN_FIREBASE_MESSAGING_SENDER_ID=""
VITE_PENGATURAN_FIREBASE_APP_ID=""

# FIREBASE CONFIGURATION (OPTIONAL FOR REMIX / CLONED PROJECTS)
# When remixing or cloning this project, configure your own Firebase credentials here:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
